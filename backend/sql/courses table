CREATE TABLE courses (
    id INT AUTO_INCREMENT PRIMARY KEY,

    title VARCHAR(200) NOT NULL,

    description TEXT,

    skill_id INT,

    difficulty ENUM(
        'Beginner',
        'Intermediate',
        'Advanced'
    ) DEFAULT 'Beginner',

    duration VARCHAR(50),

    source VARCHAR(100),

    igot_url VARCHAR(500),

    content_type ENUM(
        'Course',
        'Video',
        'PDF',
        'Document',
        'Tutorial'
    ) DEFAULT 'Course',

    created_by INT,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_course_skill
        FOREIGN KEY (skill_id)
        REFERENCES skills(id)
        ON DELETE SET NULL,

    CONSTRAINT fk_course_creator
        FOREIGN KEY (created_by)
        REFERENCES users(id)
        ON DELETE SET NULL
);