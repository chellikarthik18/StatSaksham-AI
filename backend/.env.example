# ---- MySQL database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=statsaksham

# Optional: overrides the individual DB_* values above with a full URL.
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/statsaksham?charset=utf8mb4

# ---- Auth / JWT ----
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---- CORS: origins allowed to call the API (the static frontend) ----
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

# ---- File uploads ----
UPLOAD_DIR=uploads

# ---- Optional LLM configuration for the AI Quiz Generator ----
# Leave LLM_PROVIDER empty to use the built-in deterministic generator
# (no API key required). Only set these if you want to plug in a real LLM.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

DEBUG=true
